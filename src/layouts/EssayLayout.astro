---
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const purchaseUrl = "https://softwarezen.com.br/livros/antes-de-mim/";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  inLanguage: "pt-BR",
  mainEntityOfPage: canonicalUrl.href,
  author: { "@type": "Person", name: "Raphael Albino", url: "https://rapha-albino.com.br" },
  isPartOf: { "@type": "Book", name: "Antes de Mim" },
});
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={`${title} — Antes de Mim`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={articleSchema}></script>
    <title>{title} — Antes de Mim</title>
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader />
    <main id="conteudo" class="essay" tabindex="-1">
      <a class="essay-back" href="/#caminhos">← Voltar aos caminhos de leitura</a>
      <slot />
      <section class="essay-cta" aria-label="Convite à leitura do livro">
        <p>Este ensaio continua uma conversa aberta em <em>Antes de Mim</em>.</p>
        <a class="button primary" href={purchaseUrl} target="_blank" rel="noopener noreferrer">Adquirir o livro <span aria-hidden="true">↗</span></a>
      </section>
      <nav class="essay-return" aria-label="Retorno aos caminhos de leitura">
        <a class="essay-back" href="/#caminhos">← Voltar aos caminhos de leitura</a>
      </nav>
    </main>
    <SiteFooter />
  </body>
</html>
