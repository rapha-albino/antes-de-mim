---
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

const purchaseUrl = "https://softwarezen.com.br/livros/antes-de-mim/";
const videoUrl = "https://www.youtube.com/watch?v=UYHlW2VYCOo";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const coverUrl = new URL("/images/capa-antes-de-mim.jpg", Astro.site);
const description = "Antes de Mim, de Raphael Albino: 29 ensaios sobre ancestralidade, raça, trabalho, amor e a possibilidade de existir inteiro.";
const bookSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Book",
  name: "Antes de Mim",
  alternateName: "Um reencontro com quem nos torna quem somos",
  author: {
    "@type": "Person",
    name: "Raphael Albino",
    url: "https://rapha-albino.com.br",
    sameAs: ["https://www.instagram.com/rapha_albino/"],
  },
  description,
  inLanguage: "pt-BR",
  numberOfPages: 130,
  image: coverUrl.href,
  url: canonicalUrl.href,
  offers: {
    "@type": "Offer",
    url: purchaseUrl,
    availability: "https://schema.org/InStock",
  },
});

const readingPaths = [
  { number: "01", title: "O esforço de ser inteiro", question: "O que eu precisei esconder para caber?", href: "/ensaios/esforco-de-ser-inteiro/" },
  { number: "02", title: "A ruptura que evita a traição de si", question: "O que já não pode seguir comigo?", href: "/ensaios/ruptura-e-traicao-de-si/" },
  { number: "03", title: "O passado não é um lugar para morar", question: "Como carregar a história sem deixá-la decidir tudo?", href: "/ensaios/passado-nao-e-morada/" },
];

const chapters = [
  ["03:38", 218, "Uma vida para escrever"],
  ["27:05", 1625, "O esforço de ser inteiro"],
  ["57:07", 3427, "Passado, dor e protagonismo"],
  ["1:14:08", 4448, "Ancestralidade e empatia"],
  ["1:30:36", 5436, "Esperança como vontade de viver"],
];

const testimonials = [
  ["Mariana Graf", "Além de ter destacado algumas frases que me trouxeram impacto, exercitei ideias que pareciam velhas conhecidas, mas renderam um mergulho profundo na vida que estou reconstruindo."],
  ["Fer Baruk", "Me senti como se tivesse o privilégio de uma conversa de fala calma, daquelas que chegam e te explodem por dentro."],
  ["Pérola do Amaral Franco", "Em 130 páginas, Raphael me fez rir e chorar com suas histórias."],
  ["Priscila K.", "Albino dá voz ao que muitos vivenciam e sentem, mas frequentemente não encontram espaço para expressar."],
  ["Diego Eis", "Você se vê. Você vê outras pessoas. Entendendo a perspectiva do outro, expande muito o seu senso de empatia e visão de mundo."],
  ["Jeniffer Deus", "Um convite a honrar o passado, estar no presente e imaginar futuros mais justos e bons para todas as pessoas."],
  ["Cindy Morais", "Se o leitor se propor a refletir sobre as perguntas, já vai sair deste livro sabendo mais sobre si mesmo do que entrou."],
  ["Lucas Colucci", "Rápido, dinâmico e muito profundo: uma leitura necessária."],
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="Antes de Mim — Raphael Albino" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={coverUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Antes de Mim — Raphael Albino" />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={bookSchema}></script>
    <title>Antes de Mim — Raphael Albino</title>
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader isHome />

    <main id="conteudo" tabindex="-1">
      <section class="hero" aria-labelledby="titulo-principal">
        <div>
          <p class="eyebrow">Raphael Albino</p>
          <h1 id="titulo-principal">Quem somos não começa em nós.</h1>
          <p class="lead">Antes de cada escolha, medo, desejo ou silêncio, existem pessoas, lugares, perdas, heranças e caminhos que vieram antes.</p>
          <div class="actions">
            <a class="button primary" href="#livro">Conhecer o livro</a>
            <a class="button secondary" href={purchaseUrl} target="_blank" rel="noopener noreferrer">Ver formatos e adquirir <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <img class="book-cover" src="/images/capa-antes-de-mim.jpg" alt="Capa do livro Antes de Mim, de Raphael Albino" />
      </section>

      <section id="livro" class="book" aria-labelledby="titulo-livro">
        <div class="book-inner">
          <div>
            <p class="eyebrow">Sobre o livro</p>
            <h2 id="titulo-livro">Uma conversa, não uma fórmula.</h2>
          </div>
          <div class="book-copy">
            <p>Em <em>Antes de Mim</em>, Raphael Albino parte de memórias, ensaios e fábulas para atravessar uma pergunta simples e profunda: como viver de forma mais inteira em um mundo que tantas vezes nos ensina a nos fragmentar?</p>
            <p>O livro não oferece fórmulas para a vida. Ele abre espaço para perguntas: o que, em mim, é escolha? O que é herança? O que aprendi a esconder para caber? O que preciso reconhecer para seguir adiante com mais verdade?</p>
            <a class="button primary" href={purchaseUrl} target="_blank" rel="noopener noreferrer">Adquirir o livro <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section id="caminhos" class="section" aria-labelledby="titulo-caminhos">
        <p class="eyebrow">Depois da leitura</p>
        <h2 id="titulo-caminhos">Três caminhos para continuar a conversa.</h2>
        <p class="section-intro">O livro não se encerra na última página. Estes ensaios são três entradas para perguntas que seguem trabalhando em nós.</p>
        <ol class="reading-list">
          {readingPaths.map((path) => <li><a class="reading-path" href={path.href}><span class="path-number">{path.number}</span><span><h3>{path.title}</h3><p>{path.question}</p></span><span class="path-arrow" aria-hidden="true">→</span></a></li>)}
        </ol>
      </section>

      <section id="conversa" class="conversation" aria-labelledby="titulo-conversa">
        <div class="conversation-inner">
          <div>
            <p class="eyebrow">Lançamento · 28 de agosto</p>
            <h2 id="titulo-conversa">A conversa que abriu o livro.</h2>
          </div>
          <div class="book-copy">
            <p>No lançamento de <em>Antes de Mim</em>, a conversa saiu do livro e encontrou outras histórias: ancestralidade, solidão, vulnerabilidade, integralidade, medo, ruptura e esperança.</p>
            <p>O livro foi escrito a partir de uma trajetória pessoal, mas se completa quando passa a abrir perguntas em quem lê.</p>
            <div class="video-wrap"><iframe src="https://www.youtube-nocookie.com/embed/UYHlW2VYCOo" title="Conversa de lançamento do livro Antes de Mim" loading="lazy" allowfullscreen></iframe></div>
            <ul class="chapters" aria-label="Capítulos da conversa de lançamento">
              {chapters.map(([time, seconds, label]) => <li><a href={`${videoUrl}&t=${seconds}`} target="_blank" rel="noopener noreferrer"><time>{time}</time><span>{label} <span aria-hidden="true">↗</span></span></a></li>)}
            </ul>
          </div>
        </div>
      </section>

      <section id="vozes" class="section voices" aria-labelledby="titulo-vozes">
        <p class="eyebrow">Vozes de leitura</p>
        <h2 id="titulo-vozes">O livro começa em uma história, mas não termina nela.</h2>
        <p class="section-intro">Estas são algumas das leituras que ele encontrou pelo caminho.</p>
        <div class="testimonial-carousel" role="region" aria-roledescription="carrossel" aria-label="Relatos de leitura">
          <div class="carousel-controls">
            <p><span id="testimonial-status">1 de {testimonials.length}</span> relatos</p>
            <div><button class="carousel-button" type="button" data-carousel-previous aria-label="Ver relato anterior">←</button><button class="carousel-button" type="button" data-carousel-next aria-label="Ver próximo relato">→</button></div>
          </div>
          <div class="testimonials" data-carousel-track tabindex="0" aria-describedby="testimonial-status">
            {testimonials.map(([name, quote], index) => <figure class="testimonial" aria-label={`Relato ${index + 1} de ${testimonials.length}`}><blockquote>“{quote}”</blockquote><figcaption>{name} · Amazon</figcaption></figure>)}
          </div>
        </div>
      </section>

      <section id="autor" class="section author" aria-labelledby="titulo-autor">
        <div class="author-photo"><img src="/images/raphael-albino.jpeg" alt="Retrato de Raphael Albino, autor de Antes de Mim." /></div>
        <div><p class="eyebrow">Sobre o autor</p><h2 id="titulo-autor">Raphael Albino</h2><div class="author-copy"><p>Raphael Albino nasceu no interior de São Paulo, é filho de professores, irmão mais velho e parceiro da Jhê.</p><p>Formado em Sistemas de Informação pela UNESP, tem MBA em Gestão de Projetos pela FGV, mestrado e doutorado em Administração de Empresas pela USP, onde sua tese sobre Transformação Digital recebeu menção honrosa em 2022.</p><p>Atua há mais de 18 anos em tecnologia, integrando negócios, pessoas e sistemas para transformar ideias em impacto. É autor de <em>Métricas Ágeis</em> e coautor de <em>Dynamic Flow</em>.</p></div></div>
      </section>

      <section id="encontros" class="section events" aria-labelledby="titulo-encontros">
        <div><p class="eyebrow">Encontros</p><h2 id="titulo-encontros">A conversa continua em Bauru.</h2></div>
        <div class="event-card">
          <img src="/images/lancamento-bauru-20-setembro.png" width="1080" height="1350" alt="Cartaz do lançamento em Bauru: 20 de setembro, domingo, às 15h, na Biblioteca Rodrigues de Abreu." />
          <div><p class="event-date">20 de setembro · domingo · 15h</p><h3>Lançamento em Bauru</h3><p>Biblioteca Rodrigues de Abreu<br />Av. Nações Unidas, Quadra 8 — Centro<br />Bauru — SP</p><p>Sessão de autógrafos e conversa com o autor.</p></div>
        </div>
      </section>

      <section class="closing" aria-label="Convite final"><p>O passado não é um lugar para morar. Mas pode ser um lugar para escutar.</p><p><em>Antes de Mim</em> foi escrito para abrir essa conversa.</p><a class="button primary" href={purchaseUrl} target="_blank" rel="noopener noreferrer">Adquirir o livro <span aria-hidden="true">↗</span></a></section>
    </main>

    <SiteFooter />

    <script>
      const navigationLinks = [...document.querySelectorAll<HTMLAnchorElement>(".site-nav [data-section]")];
      const sections = navigationLinks
        .map((link) => document.getElementById(link.dataset.section ?? ""))
        .filter((section): section is HTMLElement => section !== null);

      const setActiveLink = (id: string) => {
        navigationLinks.forEach((link) => {
          if (link.dataset.section === id) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };

      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setActiveLink(visible.target.id);
      }, { rootMargin: "-35% 0px -55% 0px", threshold: [0, 0.2, 0.5] });

      sections.forEach((section) => observer.observe(section));
      navigationLinks.forEach((link) => link.addEventListener("click", () => setActiveLink(link.dataset.section ?? "")));

      const carousel = document.querySelector<HTMLElement>("[data-carousel-track]");
      const previous = document.querySelector<HTMLButtonElement>("[data-carousel-previous]");
      const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");
      const status = document.getElementById("testimonial-status");

      if (carousel && previous && next && status) {
        const cards = [...carousel.querySelectorAll<HTMLElement>(".testimonial")];
        let current = 0;
        const updateCarousel = () => {
          current = Math.min(cards.length - 1, Math.max(0, Math.round(carousel.scrollLeft / cards[0].offsetWidth)));
          status.textContent = `${current + 1} de ${cards.length}`;
        };
        const showCard = (index: number) => {
          current = (index + cards.length) % cards.length;
          carousel.scrollTo({ left: cards[current].offsetLeft, behavior: "smooth" });
          status.textContent = `${current + 1} de ${cards.length}`;
        };
        previous.addEventListener("click", () => showCard(current - 1));
        next.addEventListener("click", () => showCard(current + 1));
        updateCarousel();
      }
    </script>
  </body>
</html>
